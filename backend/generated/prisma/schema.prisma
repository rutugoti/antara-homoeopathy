generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Branch {
  MAIN
  BRANCH_1
  BRANCH_2
}

enum AppointmentStatus {
  PENDING
  IN
  CLOSED
  CANCELLED
}

enum MaritalStatus {
  MARRIED
  UNMARRIED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(RECEPTIONIST)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[] @relation("DoctorAppointments")

  @@map("users")
}

model Patient {
  id            String         @id @default(cuid())
  fileId        String         @unique
  firstName     String
  lastName      String
  gender        Gender
  dateOfBirth   DateTime       @db.Date
  phone         String
  email         String?
  address       String?
  bloodGroup    String? // e.g. A+, B+, O+, AB+, A-, B-, O-, AB-
  occupation    String?
  reference     String?
  maritalStatus MaritalStatus?
  education     String?
  profileImage  String? // Cloudinary URL
  note          String?        @db.Text
  age           Int? // stored for quick display
  branch        Branch         @default(MAIN)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  appointments  Appointment[]
  prescriptions Prescription[]
  caseTaking    CaseTaking?
  followUps     FollowUp[]
  invoices      Invoice[]

  @@map("patients")
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  doctorId  String?
  branch    Branch            @default(MAIN)
  date      DateTime          @db.Date
  time      String
  reason    String?
  notes     String?
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User?   @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model Prescription {
  id        String   @id @default(cuid())
  patientId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model Holiday {
  id            String   @id @default(cuid())
  title         String
  date          DateTime @db.Date
  morningTime   String?
  afternoonTime String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("holidays")
}

model AppointmentSettings {
  id                 String   @id @default(cuid())
  morningStartTime   String // e.g. "09:00 AM"
  morningEndTime     String // e.g. "02:00 PM"
  afternoonStartTime String // e.g. "02:01 PM"
  afternoonEndTime   String // e.g. "11:59 PM"
  oldPatientTime     Int // in minutes
  newPatientTime     Int // in minutes
  oldPatientFee      Float
  newPatientFee      Float
  workingDays        String[] // e.g. ["Monday", "Tuesday", ...]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("appointment_settings")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime @db.Date
  time        String
  location    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model CaseTaking {
  id             String   @id @default(cuid())
  patientId      String   @unique
  historyTakenBy String?
  beforeImages   String[] // Array of Cloudinary URLs
  afterImages    String[] // Array of Cloudinary URLs
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("case_takings")
}

model FollowUp {
  id                String   @id @default(cuid())
  patientId         String
  followUp          String
  weight            String?
  bp                String?
  appointmentCharge Float?
  historyTakenBy    String
  remedy            String
  dosage            String?
  repetition        String?
  potency           String
  days              String?
  prescriptionType  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}

model Invoice {
  id               String   @id @default(cuid())
  patientId        String
  invoiceNo        String   @unique
  diagnosis        String
  prescriptionDate DateTime @db.Date
  prescription     String   @db.Text
  amount           Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("invoices")
}
